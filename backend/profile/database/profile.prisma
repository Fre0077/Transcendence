generator client {
  provider = "prisma-client-js"
  output   = "./generate/profile"
}

datasource db {
  provider = "sqlite"
  url = "file:./profile.db"
}

model Metadata {
  id                String @id @default(uuid())
  origin            String         //casual-lobby oppure tournament
  originId          String         //id della origin, o casual o torneo
  room              String?        //serve per il grafico piramidale del torneo
  game              Game?
}

model Game {
  id      Int   @id @default(autoincrement())
  game        String
  gameId      String
  winner      String
  score       String
  replay      String
  gamePlayers String

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  
  players User[]
  metadata Metadata? @relation(fields: [metadataId], references: [id])
  metadataId String? @unique
}

model User {
  id       Int     @id @default(autoincrement())
  linkId   Int     @unique
  username String?
  avatarUrl String?

  wins            Int @default(0)  //spostare nel db di profile
	losses          Int @default(0)  //

	tournamentWins   Int @default(0) //
	tournamentLosses Int @default(0) //

  //Gli utenti che IO ho aggiunto come amici
  friends   User[] @relation("friends")
  //Gli utenti che hanno aggiunto ME come amico
  friendOf  User[] @relation("friends")

  // Chi vuole essere mio amico
  incomingRequests User[] @relation("requests")
  // A chi ho chiesto io l'amicizia
  outgoingRequests User[] @relation("requests")

  history Game[]
}